# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Default Administrator Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@fromex.com
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password
DEFAULT_ADMIN_USERNAME=fromex
DEFAULT_ADMIN_NAME=FROMEX System Admin

# Storage Monitor Quota in MB (Default 512 for MongoDB Atlas Free Tier M0)
MONGODB_STORAGE_LIMIT_MB=512

# Server Configuration
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
