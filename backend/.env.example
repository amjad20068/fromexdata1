# Database connection string (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# If no external PostgreSQL instance is reachable, the backend automatically uses
# the persistent embedded PostgreSQL engine (PGlite) storing to ./data/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fromex

# Server Port
PORT=3000

# JSON Web Token Secret (generate a strong random secret in production)
JWT_SECRET=fromex_jwt_secret_production_key_change_me_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:3000

# Environment Mode
NODE_ENV=development
